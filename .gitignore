.installed.cfg
*.egg
MANIFEST

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# Entornos virtuales
venv/
env/
ENV/
env.bak/
venv.bak/
tfg/
uoc/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

